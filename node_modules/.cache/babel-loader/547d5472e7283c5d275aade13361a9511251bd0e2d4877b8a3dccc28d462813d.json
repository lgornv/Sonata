 \\u0438 \\u0442\\u0432\\u043E\\u0440\\u0447\\u0435\\u0441\\u043A\\u0443\\u044E \\u0430\\u0442\\u043C\\u043E\\u0441\\u0444\\u0435\\u0440\\u0443 \\u0432 \\u0441\\u0442\\u0443\\u0434\\u0438\\u0438, \\u0433\\u0434\\u0435 \\u0432\\u044B \\u0441\\u043C\\u043E\\u0436\\u0435\\u0442\\u0435 \\u0440\\u0430\\u0441\\u0441\\u043B\\u0430\\u0431\\u0438\\u0442\\u044C\\u0441\\u044F \\u0438 \\u043F\\u043E\\u043B\\u043D\\u043E\\u0441\\u0442\\u044C\\u044E \\u043F\\u043E\\u0433\\u0440\\u0443\\u0437\\u0438\\u0442\\u044C\\u0441\\u044F \\u0432 \\u043F\\u0440\\u043E\\u0446\\u0435\\u0441\\u0441 \\u0441\\u043E\\u0437\\u0434\\u0430\\u043D\\u0438\\u044F \\u043C\\u0443\\u0437\\u044B\\u043A\\u0438.\"\n  }, void 0, false, {\n    fileName: _jsxFileName,\n    lineNumber: 66,\n    columnNumber: 9\n  }, this)\n}];\nexport default sectionsData;","map":{"version":3,"names":["sectionsData","title","content","_jsxDEV","className","children","fileName","_jsxFileName","lineNumber","columnNumber","_Fragment","src","alt"],"sources":["C:/Users/Игорь/Desktop/Sonata/src/pages/AboutUs/AboutUsData.js"],"sourcesContent":["const sectionsData = [\r\n    {\r\n      title: null, // Секция без заголовка\r\n      content: <h1 className=\"page-title\">Соната — Где музыка обретает форму</h1>,\r\n    },\r\n    {\r\n      title: null,\r\n      content: (\r\n        <>\r\n          <img className=\"page-logo\" src=\"/img/sonata-logo.png\" alt=\"Sonata Logo\" />\r\n          <p className=\"page-description\">\r\n            Соната - это уютная, современная студия звукозаписи, где опытные звукорежиссёры, сонграйтеры и битмейкеры\r\n            помогут воплотить ваши творческие идеи.\r\n          </p>\r\n        </>\r\n      ),\r\n    },\r\n    {\r\n      title: null,\r\n      content: (\r\n        <p>\r\n          Мы прекрасно понимаем, что требуется артистам, так как побывали по обе стороны баррикад. За нашими\r\n          плечами как и собственные музыкальные проекты, так и проекты наших клиентов, которым мы помогаем\r\n          найти своё звучание.\r\n        </p>\r\n      ),\r\n    },\r\n    {\r\n      title: null,\r\n      content: (\r\n        <p>\r\n          Мы рады помочь молодым исполнителям и музыкальным коллективам в их первых творческих шагах.\r\n        </p>\r\n      ),\r\n    },\r\n    {\r\n      title: \"Профессиональное оборудование:\",\r\n      content: (\r\n        <p>\r\n          Мы используем современное аналоговое и цифровое оборудование от ведущих производителей, обеспечивая высокое качество\r\n          записи и обработки звука.\r\n        </p>\r\n      ),\r\n    },\r\n    {\r\n      title: \"Опытная команда:\",\r\n      content: (\r\n        <p>\r\n          Наши звукорежиссеры и продюсеры - профессионалы с многолетним опытом работы в различных\r\n          музыкальных жанрах. Они всегда готовы помочь вам на каждом этапе создания вашего проекта.\r\n        </p>\r\n      ),\r\n    },\r\n    {\r\n      title: \"Индивидуальный подход:\",\r\n      content: (\r\n        <p>\r\n          Мы ценим каждого клиента и стремимся найти индивидуальное решение для каждого\r\n          проекта, независимо от его масштаба и сложности.\r\n        </p>\r\n      ),\r\n    },\r\n    {\r\n      title: \"Уютная атмосфера:\",\r\n      content: (\r\n        <p>\r\n          Мы создали комфортную и творческую атмосферу в студии, где вы сможете расслабиться и\r\n          полностью погрузиться в процесс создания музыки.\r\n        </p>\r\n      ),\r\n    },\r\n  ];\r\n  \r\n  export default sectionsData;"],"mappings":";;AAAA,MAAMA,YAAY,GAAG,CACjB;EACEC,KAAK,EAAE,IAAI;EAAE;EACbC,OAAO,eAAEC,OAAA;IAAIC,SAAS,EAAC,YAAY;IAAAC,QAAA,EAAC;EAAkC;IAAAC,QAAA,EAAAC,YAAA;IAAAC,UAAA;IAAAC,YAAA;EAAA,OAAI;AAC5E,CAAC,EACD;EACER,KAAK,EAAE,IAAI;EACXC,OAAO,eACLC,OAAA,CAAAO,SAAA;IAAAL,QAAA,gBACEF,OAAA;MAAKC,SAAS,EAAC,WAAW;MAACO,GAAG,EAAC,sBAAsB;MAACC,GAAG,EAAC;IAAa;MAAAN,QAAA,EAAAC,YAAA;MAAAC,UAAA;MAAAC,YAAA;IAAA,OAAE,CAAC,eAC1EN,OAAA;MAAGC,SAAS,EAAC,kBAAkB;MAAAC,QAAA,EAAC;IAGhC;MAAAC,QAAA,EAAAC,YAAA;MAAAC,UA